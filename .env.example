# Never commit a real API key. Copy this file to .env for local development.
GROQ_API_KEY=YOUR_API_KEY_HERE
TEXT_MODEL=llama-3.3-70b-versatile
VISION_MODEL=qwen/qwen3.6-27b

# Set this after training or obtaining a fine-tuned model identifier.
# When set, it is used for text-only conversations; vision requests keep VISION_MODEL.
FINE_TUNED_MODEL=
DATABASE_PATH=data/jarvis.db

